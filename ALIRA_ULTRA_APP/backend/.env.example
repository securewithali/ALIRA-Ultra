# ALIRA Backend — Server environment vTABBUbles
# Server pe .env file banao, GitHub mein KABHI mat daalo

# Firebase Admin SDK JSON — server pe sirf
GOOGLE_APPLICATION_CREDENTIALS=/secure/speen-to-earn-firebase-adminsdk.json

# Admin secret — strong random string (openssl rand -hex 32)
ALIRA_ADMIN_SECRET=change-this-to-strong-random-secret

# Session expiry in hours (720 = 30 days)
SESSION_TTL_HOURS=720
